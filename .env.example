# Copy this file to .env and fill in real values. Never commit .env.

# Pooled Neon Postgres connection (PgBouncer endpoint, hostname contains
# "-pooler"). Used by the running application (src/prisma.ts) for all normal
# runtime queries.
DATABASE_URL=

# Direct (non-pooled) Neon Postgres connection to the SAME project, database,
# and schema as DATABASE_URL (hostname does NOT contain "-pooler"). Used only
# by Prisma CLI commands (migrate, validate, studio) via prisma.config.ts, so
# that schema migrations run against a direct session instead of through
# PgBouncer's transaction pooling. Get this from the Neon dashboard's
# Connection Details panel — do not derive it by editing DATABASE_URL.
DIRECT_URL=

# Secret used by Auth.js (next-auth v5) to sign session tokens.
AUTH_SECRET=

# Immutable User.id of the one authorized NIA platform founder account.
# Obtain it through a restricted database operation; never use email or name.
# This must be configured server-side in Vercel for Production separately.
NIA_SUPER_ADMIN_USER_ID=

# Separate, distinct secret (never reuse AUTH_SECRET) for HMAC-hashing the
# member-auth rate limiter's SOURCE/TARGET/GLOBAL bucket keys before they are
# persisted. Required at least 32 characters (e.g. `openssl rand -base64
# 32`); the limiter fails closed (denies) if this is missing or too short.
# See src/services/circle-member-auth-rate-limit.service.ts.
MEMBER_AUTH_RATE_LIMIT_SECRET=

# A connection string to a database that is NOT DATABASE_URL/DIRECT_URL --
# e.g. a separate, dedicated Neon branch created just for testing. Required
# for the standard `pnpm test` command. Never point this at Production,
# Preview, or a shared database.
TEST_DATABASE_URL=

# Exact Neon branch ID for the dedicated, isolated test branch in
# TEST_DATABASE_URL (format: br-...). The test bootstrap opens read-only
# connections to verify this identity and to prove it differs from the
# configured application branch before any database-writing test can load.
NIA_TEST_DATABASE_BRANCH_ID=
