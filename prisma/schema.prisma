generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalCustodianStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
  CANCELLED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DepositVerificationMode {
  OWNER
  CUSTODIAN
}

enum CircleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CircleMemberStatus {
  ACTIVE
  REMOVED
}

enum ContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayoutRoundStatus {
  UPCOMING
  ACTIVE
  PAID
  CLOSED
}

enum ContributionStatus {
  DUE
  PAID
  MISSED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  passwordHash String?

  ownedGoals        PersonalGoal[]  @relation("GoalOwner")
  assignedCustody   GoalCustodian[] @relation("CustodianUser")
  assignedDeposits  Deposit[]       @relation("DepositApprover")
  rejectedDeposits  Deposit[]       @relation("DepositRejector")
  recordedDeposits  Deposit[]       @relation("DepositRecorder")
  ownedCircles      SavingsCircle[] @relation("CircleOwner")
  circleMemberships CircleMember[]  @relation("CircleMemberUser")
  assignedByCustody GoalCustodian[] @relation("CustodianAssigner")
  endedCustody      GoalCustodian[] @relation("CustodianEnder")
  cancelledCustody  GoalCustodian[] @relation("CustodianCanceller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonalGoal {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  name         String
  currency     String     @db.Char(3)
  targetAmount Decimal    @db.Decimal(18, 2)
  weeklyAmount Decimal    @db.Decimal(18, 2)
  startDate    DateTime
  unlockDate   DateTime
  status       GoalStatus @default(ACTIVE)
  completedAt  DateTime?
  archivedAt   DateTime?

  deposits   Deposit[]
  custodians GoalCustodian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model GoalCustodian {
  id     String       @id @default(cuid())
  goalId String
  goal   PersonalGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  // A custodian can be invited before they have a platform account.
  userId        String?
  user          User?               @relation("CustodianUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName   String
  email         String?
  status        GoalCustodianStatus @default(PENDING)
  assignedById  String
  assignedBy    User                @relation("CustodianAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  endedById     String?
  endedBy       User?               @relation("CustodianEnder", fields: [endedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?               @relation("CustodianCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  assignedAt DateTime  @default(now())
  acceptedAt DateTime?
  declinedAt DateTime?
  endedAt    DateTime?
  updatedAt  DateTime  @updatedAt

  responsibleDeposits Deposit[] @relation("DepositResponsibleCustodian")

  @@unique([id, goalId])
  // PostgreSQL migration adds a partial unique index: one ACTIVE custodian per goal.
  @@index([goalId, status])
  @@index([userId, status])
}

model Deposit {
  id     String       @id @default(cuid())
  goalId String
  goal   PersonalGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  amount                 Decimal                 @db.Decimal(18, 2)
  depositDate            DateTime
  recordedById           String
  recordedBy             User                    @relation("DepositRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verificationMode       DepositVerificationMode
  responsibleCustodianId String?
  responsibleCustodian   GoalCustodian?          @relation("DepositResponsibleCustodian", fields: [responsibleCustodianId, goalId], references: [id, goalId], onDelete: Restrict)
  clientOperationId      String
  status                 DepositStatus           @default(PENDING)
  note                   String?
  rejectionReason        String?                 @db.VarChar(500)

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("DepositApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedAt   DateTime?
  rejectedById String?
  rejectedBy   User?     @relation("DepositRejector", fields: [rejectedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, clientOperationId])
  @@index([goalId, status])
}

model SavingsCircle {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  name               String
  currency           String                @db.Char(3)
  contributionAmount Decimal               @db.Decimal(18, 2)
  frequency          ContributionFrequency
  status             CircleStatus          @default(DRAFT)
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?

  members       CircleMember[]
  rounds        PayoutRound[]
  contributions Contribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model CircleMember {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  // Circle membership is the identity boundary; linking a User is optional.
  userId      String?
  user        User?   @relation("CircleMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName String
  email       String?
  memberCode  String?
  pinHash     String?

  payoutOrder Int?
  status      CircleMemberStatus @default(ACTIVE)
  removedAt   DateTime?
  updatedAt   DateTime           @updatedAt

  contributions Contribution[]
  payoutRounds  PayoutRound[]  @relation("RoundReceiver")

  @@unique([circleId, payoutOrder])
  @@unique([circleId, memberCode])
  @@unique([circleId, userId])
  @@unique([id, circleId])
  @@index([circleId, status])
  @@index([userId])
}

model PayoutRound {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  roundNumber Int
  dueDate     DateTime
  status      PayoutRoundStatus @default(UPCOMING)

  // This relation preserves the receiver for this historical round.
  receiverId String
  receiver   CircleMember @relation("RoundReceiver", fields: [receiverId, circleId], references: [id, circleId], onDelete: Restrict)

  contributions Contribution[]
  activatedAt   DateTime?
  paidAt        DateTime?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([circleId, roundNumber])
  @@unique([circleId, receiverId])
  @@unique([id, circleId])
  @@index([circleId, status])
}

model Contribution {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  roundId  String
  round    PayoutRound  @relation(fields: [roundId, circleId], references: [id, circleId], onDelete: Restrict)
  memberId String
  member   CircleMember @relation(fields: [memberId, circleId], references: [id, circleId], onDelete: Restrict)

  amount   Decimal            @db.Decimal(18, 2)
  status   ContributionStatus @default(DUE)
  paidAt   DateTime?
  missedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, memberId])
  @@index([circleId, memberId, status])
  @@index([circleId, roundId, status])
}
