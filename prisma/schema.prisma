generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalCustodianStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
  CANCELLED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DepositVerificationMode {
  OWNER
  CUSTODIAN
}

enum CircleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CircleMemberStatus {
  ACTIVE
  REMOVED
}

enum ContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayoutRoundStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum ContributionObligationStatus {
  OPEN
  FULFILLED
}

enum ContributionPaymentStatus {
  RECORDED
  CONFIRMED
  REJECTED
}

enum PayoutStatus {
  RECORDED
  CONFIRMED
  DISPUTED
}

enum CircleMemberAuthRateLimitScope {
  SOURCE
  TARGET
  GLOBAL
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String? @unique
  passwordHash String?

  ownedGoals                    PersonalGoal[]        @relation("GoalOwner")
  assignedCustody               GoalCustodian[]       @relation("CustodianUser")
  assignedDeposits              Deposit[]             @relation("DepositApprover")
  rejectedDeposits              Deposit[]             @relation("DepositRejector")
  recordedDeposits              Deposit[]             @relation("DepositRecorder")
  ownedCircles                  SavingsCircle[]       @relation("CircleOwner")
  circleMemberships             CircleMember[]        @relation("CircleMemberUser")
  activatedCircles              SavingsCircle[]       @relation("CircleActivator")
  completedCircles              SavingsCircle[]       @relation("CircleCompleter")
  archivedCircles               SavingsCircle[]       @relation("CircleArchiver")
  addedCircleMembers            CircleMember[]        @relation("CircleMemberAdder")
  removedCircleMembers          CircleMember[]        @relation("CircleMemberRemover")
  activatedPayoutRounds         PayoutRound[]         @relation("PayoutRoundActivator")
  closedPayoutRounds            PayoutRound[]         @relation("PayoutRoundCloser")
  recordedContributionPayments  ContributionPayment[] @relation("ContributionPaymentRecorder")
  confirmedContributionPayments ContributionPayment[] @relation("ContributionPaymentConfirmer")
  rejectedContributionPayments  ContributionPayment[] @relation("ContributionPaymentRejector")
  recordedPayouts               Payout[]              @relation("PayoutRecorder")
  assignedByCustody             GoalCustodian[]       @relation("CustodianAssigner")
  endedCustody                  GoalCustodian[]       @relation("CustodianEnder")
  cancelledCustody              GoalCustodian[]       @relation("CustodianCanceller")
  completedGoals                PersonalGoal[]        @relation("GoalCompleter")
  archivedGoals                 PersonalGoal[]        @relation("GoalArchiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonalGoal {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  name          String
  currency      String     @db.Char(3)
  targetAmount  Decimal    @db.Decimal(18, 2)
  weeklyAmount  Decimal    @db.Decimal(18, 2)
  startDate     DateTime
  unlockDate    DateTime
  status        GoalStatus @default(ACTIVE)
  completedAt   DateTime?
  completedById String?
  completedBy   User?      @relation("GoalCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?      @relation("GoalArchiver", fields: [archivedById], references: [id], onDelete: Restrict)

  deposits   Deposit[]
  custodians GoalCustodian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model GoalCustodian {
  id     String       @id @default(cuid())
  goalId String
  goal   PersonalGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  // A custodian can be invited before they have a platform account.
  userId        String?
  user          User?               @relation("CustodianUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName   String
  email         String?
  status        GoalCustodianStatus @default(PENDING)
  assignedById  String
  assignedBy    User                @relation("CustodianAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  endedById     String?
  endedBy       User?               @relation("CustodianEnder", fields: [endedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?               @relation("CustodianCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  assignedAt DateTime  @default(now())
  acceptedAt DateTime?
  declinedAt DateTime?
  endedAt    DateTime?
  updatedAt  DateTime  @updatedAt

  responsibleDeposits Deposit[] @relation("DepositResponsibleCustodian")

  @@unique([id, goalId])
  // PostgreSQL migration adds a partial unique index: one ACTIVE custodian per goal.
  @@index([goalId, status])
  @@index([userId, status])
}

model Deposit {
  id     String       @id @default(cuid())
  goalId String
  goal   PersonalGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  amount                 Decimal                 @db.Decimal(18, 2)
  depositDate            DateTime
  recordedById           String
  recordedBy             User                    @relation("DepositRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verificationMode       DepositVerificationMode
  responsibleCustodianId String?
  responsibleCustodian   GoalCustodian?          @relation("DepositResponsibleCustodian", fields: [responsibleCustodianId, goalId], references: [id, goalId], onDelete: Restrict)
  clientOperationId      String
  status                 DepositStatus           @default(PENDING)
  note                   String?
  rejectionReason        String?                 @db.VarChar(500)

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("DepositApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedAt   DateTime?
  rejectedById String?
  rejectedBy   User?     @relation("DepositRejector", fields: [rejectedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goalId, clientOperationId])
  @@index([goalId, status])
}

model SavingsCircle {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  name               String
  currency           String                @db.Char(3)
  contributionAmount Decimal               @db.Decimal(18, 2)
  frequency          ContributionFrequency
  startDate          DateTime
  status             CircleStatus          @default(DRAFT)
  activatedAt        DateTime?
  activatedById      String?
  activatedBy        User?                 @relation("CircleActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  completedAt        DateTime?
  completedById      String?
  completedBy        User?                 @relation("CircleCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  archivedAt         DateTime?
  archivedById       String?
  archivedBy         User?                 @relation("CircleArchiver", fields: [archivedById], references: [id], onDelete: Restrict)

  members                 CircleMember[]
  rounds                  PayoutRound[]
  contributionObligations ContributionObligation[]
  contributionPayments    ContributionPayment[]
  payouts                 Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
}

model CircleMember {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  // Circle membership is the identity boundary; linking a User is optional.
  userId      String?
  user        User?   @relation("CircleMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName String
  email       String?
  memberCode  String
  pinHash     String

  // Durable, shared authentication security state. These values are not financial history.
  failedPinAttempts Int       @default(0)
  lockedUntil       DateTime?
  credentialVersion Int       @default(1)

  payoutOrder Int?
  status      CircleMemberStatus @default(ACTIVE)
  addedAt     DateTime           @default(now())
  addedById   String
  addedBy     User               @relation("CircleMemberAdder", fields: [addedById], references: [id], onDelete: Restrict)
  removedAt   DateTime?
  removedById String?
  removedBy   User?              @relation("CircleMemberRemover", fields: [removedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime           @updatedAt

  obligations      ContributionObligation[]
  payoutRounds     PayoutRound[]            @relation("RoundRecipient")
  confirmedPayouts Payout[]                 @relation("PayoutRecipientConfirmer")
  disputedPayouts  Payout[]                 @relation("PayoutRecipientDisputer")
  sessions         CircleMemberSession[]

  @@unique([circleId, memberCode])
  @@unique([circleId, userId])
  @@unique([id, circleId])
  // PostgreSQL migration adds a partial unique index for ACTIVE members with a payout order.
  @@index([circleId, status])
  @@index([userId])
}

model CircleMemberSession {
  id                String       @id @default(cuid())
  circleId          String
  memberId          String
  member            CircleMember @relation(fields: [memberId, circleId], references: [id, circleId], onDelete: Restrict)
  tokenHash         String       @unique
  credentialVersion Int
  createdAt         DateTime     @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime?

  // Runtime contract: opaque token hashes only. Successful authentication resets failures;
  // PIN rotation increments the member version and revokes sessions; logout revokes one session.
  // Every protected request verifies version, expiry, revocation, and current membership eligibility.
  // These membership sessions remain separate from platform User/Auth.js sessions.
  @@index([memberId, revokedAt])
  @@index([expiresAt])
}

model CircleMemberAuthRateLimitBucket {
  id           String                         @id @default(cuid())
  scope        CircleMemberAuthRateLimitScope
  keyHash      String                         @db.Char(64)
  windowStart  DateTime
  attemptCount Int                            @default(0)
  expiresAt    DateTime
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  // Ephemeral, HMAC-keyed security infrastructure: expired buckets may be deleted
  // without altering domain history. Cleanup keeps this table bounded; secret rotation
  // is a future server-configuration concern, not persisted state.
  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model PayoutRound {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  roundNumber Int
  dueDate     DateTime
  status      PayoutRoundStatus @default(UPCOMING)

  // This relation preserves the recipient for this historical round.
  recipientId String
  recipient   CircleMember @relation("RoundRecipient", fields: [recipientId, circleId], references: [id, circleId], onDelete: Restrict)

  activatedAt   DateTime?
  activatedById String?
  activatedBy   User?     @relation("PayoutRoundActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  closedAt      DateTime?
  closedById    String?
  closedBy      User?     @relation("PayoutRoundCloser", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  obligations ContributionObligation[]
  payouts     Payout[]

  @@unique([circleId, roundNumber])
  @@unique([circleId, recipientId])
  @@unique([id, circleId])
  @@index([circleId, status, roundNumber])
}

model ContributionObligation {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  roundId  String
  round    PayoutRound  @relation(fields: [roundId, circleId], references: [id, circleId], onDelete: Restrict)
  memberId String
  member   CircleMember @relation(fields: [memberId, circleId], references: [id, circleId], onDelete: Restrict)

  expectedAmount Decimal                      @db.Decimal(18, 2)
  currency       String                       @db.Char(3)
  dueDate        DateTime
  status         ContributionObligationStatus @default(OPEN)
  fulfilledAt    DateTime?

  payments  ContributionPayment[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([roundId, memberId])
  @@unique([id, circleId])
  @@index([circleId, roundId, status])
}

model ContributionPayment {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  obligationId String
  obligation   ContributionObligation @relation(fields: [obligationId, circleId], references: [id, circleId], onDelete: Restrict)

  amount            Decimal                   @db.Decimal(18, 2)
  currency          String                    @db.Char(3)
  status            ContributionPaymentStatus @default(RECORDED)
  clientOperationId String
  recordedAt        DateTime                  @default(now())
  recordedById      String
  recordedBy        User                      @relation("ContributionPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedAt       DateTime?
  confirmedById     String?
  confirmedBy       User?                     @relation("ContributionPaymentConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  rejectedAt        DateTime?
  rejectedById      String?
  rejectedBy        User?                     @relation("ContributionPaymentRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  rejectionReason   String?                   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([circleId, clientOperationId])
  @@index([circleId, obligationId, status])
}

model Payout {
  id       String        @id @default(cuid())
  circleId String
  circle   SavingsCircle @relation(fields: [circleId], references: [id], onDelete: Restrict)

  roundId String
  round   PayoutRound @relation(fields: [roundId, circleId], references: [id, circleId], onDelete: Restrict)

  amount              Decimal       @db.Decimal(18, 2)
  currency            String        @db.Char(3)
  status              PayoutStatus  @default(RECORDED)
  clientOperationId   String
  recordedAt          DateTime      @default(now())
  recordedById        String
  recordedBy          User          @relation("PayoutRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  confirmedAt         DateTime?
  confirmedByMemberId String?
  confirmedByMember   CircleMember? @relation("PayoutRecipientConfirmer", fields: [confirmedByMemberId, circleId], references: [id, circleId], onDelete: Restrict)
  disputedAt          DateTime?
  disputedByMemberId  String?
  disputedByMember    CircleMember? @relation("PayoutRecipientDisputer", fields: [disputedByMemberId, circleId], references: [id, circleId], onDelete: Restrict)
  disputeReason       String?       @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId])
  @@unique([circleId, clientOperationId])
  @@index([circleId, status])
}
